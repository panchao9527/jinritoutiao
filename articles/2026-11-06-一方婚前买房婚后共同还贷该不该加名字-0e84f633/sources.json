  "claims": [
    {
      "claim": "符合解释（一）第78条所列条件时，离婚先协议；协议不成可以判房屋归登记方并就共同还贷及对应增值依法补偿另一方。",
      "source_ids": [
        "s1"
      ]
    },
    {
      "claim": "不能将加名等同固定分半；解释（二）第5条第2款对已转移登记、短婚且给予方无重大过错等情形规定裁判与补偿因素。",
      "source_ids": [
        "s2"
      ]
    },
    {
      "claim": "婚后工资等通常属于共同财产；书面财产约定及具体情况须另行分析。",
      "source_ids": [
        "s3"
      ]
    }
